import type { Maybe } from "Maybe"

import type { Action } from "@/Action"

import Action from "@/Action"



export type Actor e z
  = Actor(
    // name
    String,
    // potential actions
    List (Action e z),
  )

behave :: Maybe a -> Actor a b -> Maybe (Dictionary Float (List String))
export behave = (subject, actor) => where(actor) {
  Actor(actorName, behaviors) =>
    Action.playbook(behaviors, subject)
}
